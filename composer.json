{
  "name": "flexi/flexi-module-webhooks",
  "description": "WebHooks module for Flexi Framework",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "webhooks",
    "events"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1",
    "flexi/flexi-module-auth": "^2.0",
    "psr/http-message": "^2.0",
    "psr/http-factory": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\WebHooks\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "WebHooks",
      "module-type": "infrastructure",
      "config-files": [
        "Config/routes.json"
      ],
      "provides": [
        "webhooks",
        "webhook-events"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\WebHooks\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "guzzlehttp/psr7": "^2.7"
  }
}
